<?xml version="1.0"?>
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        bootstrap="tests/bootstrap.php"
        backupGlobals="false"
        colors="true"
        xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit/</directory>
        </testsuite>

        <testsuite name="Integration">
            <directory suffix="Test.php">./tests/Integration/</directory>
        </testsuite>

        <testsuite name="Arch">
            <directory suffix="Test.php">./tests/Arch/</directory>
        </testsuite>
    </testsuites>

    <!--
        Defines what coverage measures when it is requested. Deliberately no <coverage><report>
        block: declaring report outputs here makes PHPUnit enable coverage collection on every
        run, which then hard-fails when no Xdebug or PCOV is installed. Ask for coverage on the
        command line instead, via `composer test-coverage`.
    -->
    <source>
        <include>
            <directory suffix=".php">./src/</directory>
        </include>
    </source>
</phpunit>
